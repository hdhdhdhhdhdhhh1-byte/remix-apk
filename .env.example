# Nico AI — Environment variables
#
# Copy to `.env` and fill in with your own values.
# Never commit `.env` — only `.env.example`.

# ─── Supabase (public, safe for the browser) ───────────────────────────
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# SSR fallbacks — same values, without the VITE_ prefix, for server
# functions and TanStack Start's Node/Worker runtime.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<your-project-ref>"

# ─── Supabase (server-only, NEVER expose to the browser) ───────────────
# Used by admin server functions (webhook writes, background jobs).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── AI Gateway (server-only) ──────────────────────────────────────────
# Nico calls STT / LLM / TTS through Lovable's AI Gateway using this key.
# If you self-host, replace with your own provider keys and adapt
# `src/routes/api/nico/*.ts` accordingly.
LOVABLE_API_KEY=""

# ─── Optional ──────────────────────────────────────────────────────────
# NODE_ENV=development