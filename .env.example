# Nico AI — Environment variables
#
# Copy to `.env` and fill in with your own values.
# Never commit `.env` — only `.env.example`.

# ─── Supabase (public, safe for the browser) ───────────────────────────
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# SSR fallbacks — same values, without the VITE_ prefix, for server
# functions and TanStack Start's Node/Worker runtime.
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="<your-project-ref>"

# ─── Supabase (server-only, NEVER expose to the browser) ───────────────
# Used by admin server functions (webhook writes, background jobs).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─── AI Provider (server-only) ─────────────────────────────────────────
# Nico's chat / STT / TTS routes call any OpenAI-compatible endpoint.
# Works with OpenAI, OpenRouter, Groq, LiteLLM, self-hosted vLLM, …
AI_PROVIDER="openai"
AI_API_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# Optional overrides:
# AI_STT_MODEL="gpt-4o-mini-transcribe"
# AI_TTS_MODEL="gpt-4o-mini-tts"
# AI_TTS_VOICE="alloy"

# Legacy: if only LOVABLE_API_KEY is set, the AI layer falls back to
# https://ai.gateway.lovable.dev for backwards compatibility.
# LOVABLE_API_KEY=""

# ─── Optional ──────────────────────────────────────────────────────────
# NODE_ENV=development